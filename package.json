{
	"name": "root",
	"private": true,
	"type": "module",
	"scripts": {
		"check-deps": "node scripts/check-deps.js",
		"dev": "pnpm run check-deps && pnpm --filter \"@renanzan/zanoti.dev\" dev",
		"build": "pnpm --filter \"@renanzan/zanoti.dev\" build",
		"start": "pnpm --filter \"@renanzan/zanoti.dev\" start",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"format:ts": "prettier --write \"**/*.{ts,tsx}\" --ignore-path .prettierignore",
		"format:js": "prettier --write \"**/*.{js,jsx}\" --ignore-path .prettierignore",
		"format:json": "prettier --write \"**/*.json\" --ignore-path .prettierignore",
		"format:css": "prettier --write \"**/*.css\" --ignore-path .prettierignore",
		"format:code": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --ignore-path .prettierignore",
		"lint": "pnpm --filter \"*\" lint",
		"type-check": "pnpm --filter \"*\" type-check"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@next/eslint-plugin-next": "^16.2.3",
		"enquirer": "^2.4.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.2",
		"typescript": "catalog:",
		"typescript-eslint": "^8.58.2"
	},
	"packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
